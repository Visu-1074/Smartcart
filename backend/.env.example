DATABASE_URL=sqlite:///./smartcart.db
PRICE_REFRESH_MINUTES=30
FRONTEND_ORIGIN=http://localhost:5173
PLATFORM_TIMEOUT_SECONDS=6

# Optional. Amazon/Flipkart use a dated community export unless live API mode and credentials work.
# Other unconfigured platforms stay mock and remain hidden unless demo listings are enabled.
PLATFORM_MODE_AMAZON_IN=mock
AMAZON_CREATORS_CLIENT_ID=
AMAZON_CREATORS_CLIENT_SECRET=
AMAZON_CREATORS_VERSION=
AMAZON_PARTNER_TAG=
PLATFORM_MODE_FLIPKART=mock
FLIPKART_AFFILIATE_ID=
FLIPKART_AFFILIATE_TOKEN=

# QuickCommerceAPI live Blinkit search (requires a QuickCommerceAPI key and coordinates).
PLATFORM_MODE_BLINKIT=api
QUICKCOMMERCE_API_KEY=
QUICKCOMMERCE_LAT=12.90
QUICKCOMMERCE_LON=77.66

# Optional Cuelinks deeplink conversion (does not provide merchant product feeds).
CUELINKS_API_KEY=

# Optional headed Amazon review session. Generate the key with Fernet.generate_key().
AMAZON_CHECKOUT_ENABLED=false
SMARTCART_ENCRYPTION_KEY=

# Optional local partner-feed files, e.g. JSON array or CSV normalized to SmartCart fields.
# Set PLATFORM_MODE_<PLATFORM_ID>=api to activate a configured feed.
# AFFILIATE_FEED_AMAZON_IN=
